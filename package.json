{
  "name": "ai-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered translator with pluggable model providers, shipped as a web app and a browser extension.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test packages/core/test/*.test.ts apps/extension/test/*.test.ts",
    "test:watch": "node --test --watch packages/core/test/*.test.ts apps/extension/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build:web": "bun run apps/web/build.ts",
    "build:extension": "bun run apps/extension/build.ts",
    "build": "npm run build:web && npm run build:extension",
    "dev:web": "bun run apps/web/build.ts --watch --serve",
    "dev:extension": "bun run apps/extension/build.ts --watch",
    "preview:extension": "bun run apps/extension/preview/serve.ts",
    "check": "npm run typecheck && npm test",
    "verify": "npm run build && npm run typecheck && npm test"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "22",
    "typescript": "5"
  }
}
