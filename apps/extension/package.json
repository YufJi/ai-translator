{
  "name": "@ai-translator/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "rm -rf dist && vite build && BUILD_TARGET=background vite build && BUILD_TARGET=content vite build",
    "preview": "vite --config preview/vite.config.ts",
    "build:preview": "vite build --config preview/vite.config.ts",
    "icons": "node scripts/make-icons.ts"
  },
  "dependencies": {
    "@ai-translator/core": "workspace:*",
    "@ai-translator/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
